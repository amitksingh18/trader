ANTHROPIC_API_KEY=your_anthropic_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: TradingView will send this back in the alert JSON so random
# internet traffic can't trigger fake alerts on your server. Pick any string.
WEBHOOK_SECRET=choose_a_random_string_here

# Optional — read-only Groww portfolio lookups (holdings + live price).
# Get these from https://groww.in/trade-api/api-keys — regenerated daily,
# so this needs refreshing each trading day. Leave blank to skip this feature
# entirely; the pipeline works fine without it.
GROWW_API_KEY=
GROWW_API_SECRET=

# Optional — logs every alert as a row in a Google Sheet, in addition to the
# local CSV journal. Get GOOGLE_SERVICE_ACCOUNT_JSON by creating a Google
# Cloud service account and downloading its JSON key (paste the whole file's
# contents here as one line). GOOGLE_SHEET_ID is the long ID in your sheet's
# URL: docs.google.com/spreadsheets/d/THIS_PART/edit
# Remember to share the sheet with the service account's email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
