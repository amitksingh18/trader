ANTHROPIC_API_KEY=your_anthropic_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: TradingView will send this back in the alert JSON so random
# internet traffic can't trigger fake alerts on your server. Pick any string.
WEBHOOK_SECRET=choose_a_random_string_here

# Optional — read-only Groww portfolio lookups (holdings + live price).
# Get these from https://groww.in/trade-api/api-keys ("Generate API key").
# Resets daily at 6 AM — needs refreshing each trading day. Leave blank to
# skip this feature entirely; the pipeline works fine without it.
GROWW_API_KEY=
GROWW_API_SECRET=

# Optional — read-only Zerodha (Kite Connect) portfolio lookups. Requires the
# paid Kite Connect subscription (~₹2000/mo) from https://developers.kite.trade/.
# ZERODHA_ACCESS_TOKEN expires daily and requires a real browser login each
# morning — run scripts/zerodha_login.py locally to generate it, then paste
# the value here. Leave both blank to skip this feature entirely.
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=

# Optional — logs every alert as a row in a Google Sheet, in addition to the
# local CSV journal. Get GOOGLE_SERVICE_ACCOUNT_JSON by creating a Google
# Cloud service account and downloading its JSON key (paste the whole file's
# contents here as one line). GOOGLE_SHEET_ID is the long ID in your sheet's
# URL: docs.google.com/spreadsheets/d/THIS_PART/edit
# Remember to share the sheet with the service account's email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Optional — SMS, WhatsApp message, and a spoken phone call for every alert,
# via Twilio (https://www.twilio.com/try-twilio). Leave all blank to skip;
# each of the three channels below also works independently — e.g. set only
# the SMS vars and skip WhatsApp/calling. See docs/webhook_pipeline_setup.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number (E.164, e.g. +14155551234) — used for calls, and
# for SMS if TWILIO_SMS_SENDER_ID (below) is left blank.
TWILIO_FROM_NUMBER=
# Optional — makes SMS show a text name (e.g. "TRADER") instead of a phone
# number, like a company notification. Requires registering an Alphanumeric
# Sender ID with Twilio; in India also requires DLT registration (a
# real-world telecom compliance process, not just this env var) — see
# docs/webhook_pipeline_setup.md. Leave blank to send SMS from
# TWILIO_FROM_NUMBER instead.
TWILIO_SMS_SENDER_ID=
# Twilio WhatsApp sender (E.164, e.g. +14155238886 for the sandbox).
TWILIO_WHATSAPP_FROM=
# Your own phone number (E.164, e.g. +919876543210) — where SMS, WhatsApp,
# and the call all go.
TWILIO_TO_NUMBER=
