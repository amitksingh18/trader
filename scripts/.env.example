# TOTP flow — no expiry, unlike the API key/secret flow which resets daily.
# Get these from https://groww.in/trade-api/api-keys (dropdown next to
# "Generate API key" -> "Generate TOTP token").
GROWW_TOTP_TOKEN=your_totp_token_here
GROWW_TOTP_SECRET=your_totp_secret_here

# Used by append_position_log.py for the Positions Log Google Sheet.
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/your/service-account-key.json
GOOGLE_SHEET_ID=your_google_sheet_id_here
