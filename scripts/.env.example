# Get these from https://groww.in/trade-api/api-keys ("Generate API key").
# Resets daily at 6 AM — needs refreshing each trading day.
GROWW_API_KEY=your_api_key_here
GROWW_API_SECRET=your_api_secret_here

# Used by append_position_log.py for the Positions Log Google Sheet.
GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/your/service-account-key.json
GOOGLE_SHEET_ID=your_google_sheet_id_here
